---
import Layout from '../../layouts/Layout.astro';
import KeyRingTab from '../../components/keys/KeyRingTab';
import AddressBookTab from '../../components/keys/AddressBookTab';
import EncryptTab from '../../components/encrypt/EncryptTab';
import DecryptTab from '../../components/decrypt/DecryptTab';
import WizardTab from '../../components/wizard/WizardTab';
import Toast from '../../components/shared/Toast';
import KeyStatusPill from '../../components/shared/KeyStatusPill';
import { getKeyCapability, keyCapabilityIconPaths } from '../../lib/key-capabilities';
import '../../styles/app-workspace.css';

const tabs = [
  { id: 'encrypt', label: 'Encrypt file', mobileLabel: 'Encrypt', hint: 'Protect before sharing', path: 'M7 11V7a5 5 0 0110 0v4 M5 11h14v10H5z' },
  { id: 'decrypt', label: 'Decrypt file', mobileLabel: 'Decrypt', hint: 'Open a file sent to you', path: 'M7 11V7a5 5 0 019.9-1 M5 11h14v10H5z' },
  { id: 'addressbook', label: 'Address book', mobileLabel: 'Contacts', hint: 'People you share with', path: 'M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2 M13 7a4 4 0 11-8 0 4 4 0 018 0 M18 8h4 M18 12h4 M20 16h2' },
  { id: 'wizard', label: 'Guided setup', mobileLabel: 'Setup', hint: 'A little help getting started', path: 'M9 5H5v16h14V5h-4 M9 3h6v4H9z M8 12h8 M8 16h5' },
].map((tab) => ({ ...tab, capability: tab.id === 'encrypt' || tab.id === 'decrypt' ? getKeyCapability(tab.id, false) : null }));
---

<Layout title="CryptDrop — Your private file workspace" appMode>
  <div class="app-shell">

  <aside class="app-sidebar" aria-label="Workspace sidebar">
    <div class="sidebar-keys">
      <p class="sidebar-label">My keys</p>
      <KeyStatusPill client:load />
      <p class="session-note">Your private key is needed to decrypt or sign, not to encrypt for others.</p>
    </div>
    <p class="sidebar-label">Workspace</p>
    <div class="workspace-tabs" role="tablist" aria-label="File tools" aria-orientation="vertical">
      {tabs.map((tab, index) => (
        <button type="button" class:list={['app-tab', { active: index === 0 }]} data-tab={tab.id}
          id={`nav-${tab.id}`} role="tab" aria-controls={`tab-${tab.id}`} data-capability={tab.capability?.state}
          data-label={tab.label} aria-label={`${tab.label}. ${tab.capability?.navHint ?? tab.hint}`}
          aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d={tab.path} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="nav-copy">
            <span class="nav-label"><span class="nav-label-desktop">{tab.label}</span><span class="nav-label-mobile">{tab.mobileLabel}</span></span>
            <span class="nav-hint" hidden={!!tab.capability && tab.capability.state !== 'available'}>{tab.hint}</span>
            {tab.capability && (
              <span class="nav-status-badge" aria-hidden="true" hidden={tab.capability.state === 'available'}>
                <svg class="nav-status-icon" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d={keyCapabilityIconPaths[tab.capability.state]} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="nav-status-label">{tab.capability.mobileHint}</span>
              </span>
            )}
          </span>
        </button>
      ))}
    </div>
    <a class="sidebar-help" href="/how-it-works">A quick guide to encryption <span aria-hidden="true">↗</span></a>
  </aside>

  <div class="workspace-body" id="app-workspace" tabindex="-1">
    <div class="workspace-topline"><span>FILE WORKSPACE</span><span class="workspace-local"><span aria-hidden="true"></span> Files processed on your device</span></div>
    <div class="workspace-columns">
    <div class="app-content-pad">
      <noscript><p class="notice-box notice-warn">JavaScript is required to encrypt and decrypt files locally in your browser.</p></noscript>

    <!-- ======================== ENCRYPT TAB (React Island) ======================== -->
    <div id="tab-encrypt" class="tab-panel fade-in" role="tabpanel" aria-labelledby="nav-encrypt" tabindex="0">
      <EncryptTab client:load />
    </div>

    <!-- ======================== DECRYPT TAB (React Island) ======================== -->
    <div id="tab-decrypt" class="tab-panel fade-in hidden" role="tabpanel" aria-labelledby="nav-decrypt" tabindex="0" hidden>
      <DecryptTab client:load />
    </div>

    <!-- ======================== KEY RING TAB (React Island) ======================== -->
    <div id="tab-keyring" class="tab-panel fade-in hidden" role="region" aria-labelledby="nav-keyring" tabindex="0" hidden>
      <KeyRingTab client:load />
    </div>

    <!-- ======================== ADDRESS BOOK TAB (React Island) ======================== -->
    <div id="tab-addressbook" class="tab-panel fade-in hidden" role="tabpanel" aria-labelledby="nav-addressbook" tabindex="0" hidden>
      <AddressBookTab client:load />
    </div>

    <!-- ======================== WIZARD TAB (React Island) ======================== -->
    <div id="tab-wizard" class="tab-panel fade-in hidden" role="tabpanel" aria-labelledby="nav-wizard" tabindex="0" hidden>
      <WizardTab client:load />
    </div>

    </div>
    <aside class="workspace-guide" aria-label="Encryption essentials">
      <div class="guide-symbol" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.4"/><path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <p class="guide-eyebrow">PRIVATE BY DESIGN</p>
      <h2>Your files. <br />Only the right eyes.</h2>
      <p>Encrypt on your device, then share the protected file however you like.</p>
      <dl class="guide-facts">
        <div><dt>Public key</dt><dd>Share it so others can encrypt files for you.</dd></div>
        <div><dt>Private key</dt><dd>Keep it secret. It unlocks files encrypted for you.</dd></div>
        <div><dt>No file uploads</dt><dd>File contents and private keys are processed locally. Key searches and emails use online services.</dd></div>
      </dl>
      <a href="/security">Understand the security model <span aria-hidden="true">↗</span></a>
    </aside>
    </div>
    <div class="workspace-footer"><span>Built on OpenPGP.js</span><a href="/security">Privacy &amp; security <span aria-hidden="true">↗</span></a></div>
  </div>
  </div>

  <!-- Toast (React Island) -->
  <Toast client:load />

  <!-- Tab navigation via Nano Stores -->
  <script>
    import { initAppNavigation } from '../../lib/app-navigation';
    initAppNavigation();
  </script>
</Layout>

<style is:global>
  /* ── Segmented control tab bar ── */
  .app-tab-bar {
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 3.5rem;
    z-index: 40;
  }
  .app-tab-bar-content {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0.5rem 1rem;
  }
  @media (min-width: 480px) {
    .app-tab-bar-content { padding: 0.5rem 1.5rem; }
  }
  .app-tab-identity {
    margin-bottom: 0.5rem;
  }
  .app-tab-inner {
    display: flex;
    gap: 0.25rem;
    background: #f1f5f9;
    border-radius: 0.75rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  .app-tab-inner::-webkit-scrollbar { display: none; } /* Safari/Chrome */

  /* ── Key status bar (in nav) ── */
  .key-status-bar {
    display: flex; align-items: center; gap: 0.5rem;
    width: 100%; padding: 0.5rem 0.75rem;
    border-radius: 0.5rem; border: 1px solid transparent;
    cursor: pointer; transition: all 0.15s;
    font-family: inherit; text-align: left;
  }
  .key-status-empty {
    background: #fffbeb; border-color: #fde68a; color: #78350f;
    font-size: 0.8125rem;
  }
  .key-status-empty:hover { border-color: #fbbf24; background: #fef3c7; }
  .key-status-empty svg { color: #d97706; flex-shrink: 0; }
  .key-status-empty strong { color: #b45309; font-weight: 600; }
  .key-status-loaded {
    background: #f0fdf4; border-color: #bbf7d0;
  }
  .key-status-loaded:hover { border-color: #86efac; background: #dcfce7; }
  .key-status-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: #dcfce7; color: #166534;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 700; flex-shrink: 0;
  }
  .key-status-info { flex: 1; min-width: 0; overflow: hidden; }
  .key-status-name {
    display: block; font-size: 0.8125rem; font-weight: 600; color: #166534;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .key-status-email {
    display: block; font-size: 0.6875rem; color: #16a34a;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .app-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    flex: 1;
    padding: 0.625rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #64748b;
    background: transparent;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .app-tab:hover { color: #0f172a; }
  .app-tab.active {
    color: #0f172a;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }
  .app-tab svg { opacity: 0.5; transition: opacity 0.2s; }
  .app-tab:hover svg { opacity: 0.7; }
  .app-tab.active svg { opacity: 1; }

  /* ── Fade-in animation ── */
  @keyframes fadeIn {
    0% { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }

  /* ── Spinner ── */
  @keyframes spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: spin 1s linear infinite; }

  /* ── App content padding (responsive) ── */
  .app-content-pad {
    padding: 1rem;
  }
  @media (min-width: 480px) {
    .app-content-pad { padding: 1.5rem; }
  }

  /* ── Privacy badge ── */
  .privacy-badge {
    position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.375rem 0.75rem; border-radius: 9999px;
    background: rgba(241, 245, 249, 0.9); backdrop-filter: blur(8px);
    font-size: 0.625rem; font-weight: 500; color: #64748b;
    z-index: 30; pointer-events: none;
    border: 1px solid rgba(226, 232, 240, 0.6);
  }
  @media (max-width: 640px) {
    .privacy-badge { display: none; }
  }

  /* ── File selected card ── */
  .file-selected-card {
    display: flex; align-items: center; gap: 0.75rem;
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem;
    padding: 0.75rem 1rem;
  }
  .file-selected-icon {
    width: 40px; height: 40px; border-radius: 0.625rem;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .file-selected-icon-encrypt { background: #eef2ff; color: #4f46e5; }
  .file-selected-icon-decrypt { background: #f0fdf4; color: #16a34a; }
  .file-selected-info { flex: 1; min-width: 0; }
  .file-selected-name { font-size: 0.875rem; font-weight: 500; color: #0f172a; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .file-selected-size { font-size: 0.75rem; color: #64748b; margin: 0; }
  .file-selected-check { color: #16a34a; flex-shrink: 0; }

  /* ── Tab panels ── */
  .tab-panel { min-height: 60vh; }
  .tab-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-top: 0.5rem;
  }
  .tab-title { font-size: 1.125rem; font-weight: 700; color: #111827; margin: 0 0 0.2rem; }
  .tab-subtitle { font-size: 0.8125rem; color: #6b7280; margin: 0; }

  /* ── Cards ── */
  .card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.625rem;
    padding: 1.25rem;
    margin-bottom: 0;
  }
  .card-title { font-size: 0.875rem; font-weight: 600; color: #111827; margin: 0 0 0.5rem; }
  .card-icon {
    width: 44px; height: 44px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .card-btn {
    display: flex; flex-direction: column; gap: 0.625rem;
    cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s;
    background: #fff; border: 2px solid #e5e7eb;
  }
  .card-btn:hover { border-color: #818cf8; box-shadow: 0 4px 12px rgb(99 102 241 / 0.1); }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
    background: #4f46e5; color: #fff;
    font-size: 0.875rem; font-weight: 600;
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem; border: none; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: #4338ca; }
  .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-secondary {
    display: inline-flex; align-items: center;
    background: #f3f4f6; color: #374151;
    font-size: 0.8125rem; font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem; border: 1px solid #e5e7eb; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-secondary:hover { background: #e5e7eb; }
  .btn-ghost { background: transparent; border: none; cursor: pointer; font-size: 0.8125rem; color: #9ca3af; transition: color 0.15s; padding: 0.25rem 0; }
  .btn-ghost:hover { color: #4f46e5; }
  .btn-ghost-sm { background: transparent; border: none; cursor: pointer; font-size: 0.75rem; color: #9ca3af; transition: color 0.15s; padding: 0.25rem 0.5rem; }
  .btn-ghost-sm:hover { color: #374151; }
  .btn-sm {
    display: inline-flex; align-items: center;
    background: #4f46e5; color: #fff;
    font-size: 0.75rem; font-weight: 500;
    padding: 0.375rem 0.875rem; border-radius: 0.375rem; border: none; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-sm:hover { background: #4338ca; }
  .link-inline { background: none; border: none; cursor: pointer; color: #4f46e5; font-size: inherit; padding: 0; text-decoration: underline; }
  .link-inline:hover { color: #3730a3; }

  /* ── Inputs ── */
  .input {
    border: 1px solid #d1d5db; border-radius: 0.5rem;
    padding: 0.5rem 0.75rem; font-size: 0.875rem;
    outline: none; transition: box-shadow 0.15s;
    font-family: inherit;
  }
  .input:focus { box-shadow: 0 0 0 2px #6366f1; border-color: #6366f1; }

  /* ── Drop zones ── */
  .drop-zone { border: 2px dashed #d1d5db; border-radius: 0.5rem; cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .drop-zone:hover, .drop-zone.dragover { border-color: #6366f1; background: #eef2ff; }
  .drop-zone-lg { padding: 2rem 1rem; text-align: center; }
  .drop-zone-sm { padding: 1rem; text-align: center; }
  .drop-icon { margin: 0 auto 0.5rem; color: #d1d5db; }

  /* ── Search ── */
  .search-wrap { position: relative; margin-bottom: 0.75rem; }
  .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #9ca3af; pointer-events: none; }
  .search-input { width: 100%; padding: 0.5rem 1rem 0.5rem 2.25rem; border: 1px solid #d1d5db; border-radius: 0.625rem; font-size: 0.875rem; outline: none; box-sizing: border-box; }
  .search-input:focus { box-shadow: 0 0 0 2px #6366f1; border-color: #6366f1; }

  /* ── Contact list ── */
  .contact-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }

  /* ── Empty state ── */
  .empty-state { text-align: center; padding: 3rem 1rem; }
  .empty-icon { width: 56px; height: 56px; background: #f3f4f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: #9ca3af; }
  .empty-msg { font-size: 0.875rem; font-weight: 500; color: #374151; margin: 0 0 0.25rem; }
  .empty-hint { font-size: 0.75rem; color: #9ca3af; margin: 0; }

  /* ── Encrypt contact rows ── */
  .encrypt-contact-row {
    display: flex; align-items: center; gap: 0.75rem; width: 100%;
    padding: 0.625rem 1rem; background: #fff; border: none;
    cursor: pointer; text-align: left; transition: background 0.1s;
  }
  .encrypt-contact-row:hover { background: #f8fafc; }
  .encrypt-contact-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: #eef2ff; color: #4f46e5;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 600; flex-shrink: 0;
  }
  .encrypt-contact-recent {
    font-size: 0.625rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.04em; color: #6366f1; background: #eef2ff;
    padding: 0.15rem 0.5rem; border-radius: 9999px; flex-shrink: 0;
  }

  /* ── Fingerprint tooltip anchor ── */
  .fp-tooltip-anchor {
    display: inline-flex; align-items: center; justify-content: center;
    width: 14px; height: 14px; border-radius: 50%;
    background: #e0e7ff; color: #4f46e5;
    font-size: 0.6rem; font-weight: 700; font-family: inherit;
    cursor: help; vertical-align: middle; margin-left: 2px;
    border: 1px solid #c7d2fe;
  }
  .fp-tooltip-anchor:hover { background: #c7d2fe; }

  /* ── Encrypt panel ── */
  .encrypt-panel { background: #fff; border: 1px solid #c7d2fe; border-radius: 0.75rem; padding: 1.25rem; box-shadow: 0 1px 4px rgb(99 102 241 / 0.08); }
  .encrypt-panel-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem; }
  .encrypt-panel-label { font-size: 0.625rem; font-weight: 600; color: #6366f1; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.2rem; }
  .encrypt-panel-name { font-size: 1rem; font-weight: 600; color: #111827; margin: 0 0 0.15rem; }
  .encrypt-panel-fp { font-size: 0.7rem; color: #6b7280; font-family: ui-monospace, monospace; margin: 0; }

  /* ── Notice boxes ── */
  .notice-box { border-radius: 0.5rem; padding: 0.875rem 1rem; }
  .notice-info { background: #eef2ff; border: 1px solid #c7d2fe; }
  .notice-warn { background: #fffbeb; border: 1px solid #fde68a; }
  .notice-success { background: #f0fdf4; border: 1px solid #bbf7d0; }

  /* ── Success box ── */
  .success-box { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 0.625rem; padding: 1rem 1.25rem; }
  .success-title { font-size: 0.875rem; font-weight: 600; color: #14532d; margin: 0 0 0.25rem; }
  .success-body { font-size: 0.8125rem; color: #166534; margin: 0; }

  /* ── File info ── */
  .file-info { font-size: 0.875rem; color: #4b5563; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem; }

  /* ── Divider ── */
  .divider { display: flex; align-items: center; gap: 0.75rem; font-size: 0.75rem; color: #9ca3af; margin: 0.75rem 0; }
  .divider::before, .divider::after { content: ''; flex: 1; border-top: 1px solid #e5e7eb; }

  /* ── Key badge ── */
  .key-badge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; font-weight: 500; padding: 0.25rem 0.625rem; border-radius: 9999px; }
  .key-badge-ok { background: #dcfce7; color: #15803d; }
  /* key-pill classes removed — replaced by key-status-bar in nav */

  /* ── Folder save bar ── */
  .folder-bar { display: flex; align-items: center; justify-content: space-between; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 0.5rem 0.875rem; }
  .folder-bar-inner { display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: #64748b; min-width: 0; overflow: hidden; }
  .folder-bar-inner strong { color: #334155; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
  .folder-bar-label { white-space: nowrap; }
  .btn-xs {
    display: inline-flex; align-items: center; gap: 0.25rem;
    background: #fff; color: #4f46e5; border: 1px solid #c7d2fe;
    font-size: 0.6875rem; font-weight: 600;
    padding: 0.25rem 0.625rem; border-radius: 0.375rem; cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap; flex-shrink: 0;
  }
  .btn-xs:hover { background: #eef2ff; border-color: #818cf8; }

  /* ── Sign row ── */
  .sign-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }

  /* ── Code block ── */
  .code-block { background: #fff; border: 1px solid #fde68a; border-radius: 0.375rem; padding: 0.75rem; font-size: 0.75rem; font-family: ui-monospace, monospace; color: #374151; white-space: pre-wrap; }

  /* ── Wizard progress ── */
  .wizard-progress { display: flex; align-items: center; justify-content: space-between; padding: 0.625rem 0; margin-bottom: 1rem; border-bottom: 1px solid #e5e7eb; }

  /* ── Grid ── */
  .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mt-3 { margin-top: 0.75rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-5 { margin-bottom: 1.25rem; }
  .ml-5 { margin-left: 1.25rem; }
  .mt-0\.5 { margin-top: 0.125rem; }
  .w-full { width: 100%; }

  /* ── Local assurance bar ── */
  .local-assurance-bar {
