---
import Layout from '../../layouts/Layout.astro';
import KeysTab from '../../components/keys/KeysTab';
import EncryptTab from '../../components/encrypt/EncryptTab';
import DecryptTab from '../../components/decrypt/DecryptTab';
import WizardTab from '../../components/wizard/WizardTab';
import Toast from '../../components/shared/Toast';
import KeyStatusPill from '../../components/shared/KeyStatusPill';
---

<Layout title="CryptDrop — Encrypt & Decrypt Files in Your Browser">

  <!-- ======================== TAB NAV ======================== -->
  <div class="app-tab-bar">
    <div class="app-tab-inner">
      <button class="app-tab active" data-tab="encrypt">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Encrypt
      </button>
      <button class="app-tab" data-tab="decrypt">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 11V7a5 5 0 019.9-1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Decrypt
      </button>
      <button class="app-tab" data-tab="keys">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Keys
      </button>
      <button class="app-tab" data-tab="wizard">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 000 4h6a2 2 0 000-4M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Wizard
      </button>
    </div>
  </div>

  <div class="max-w-3xl mx-auto p-6">

    <!-- ======================== ENCRYPT TAB (React Island) ======================== -->
    <div id="tab-encrypt" class="tab-panel fade-in">
      <EncryptTab client:load />
    </div>

    <!-- ======================== DECRYPT TAB (React Island) ======================== -->
    <div id="tab-decrypt" class="tab-panel fade-in hidden">
      <DecryptTab client:load />
    </div>

    <!-- ======================== KEYS TAB (React Island) ======================== -->
    <div id="tab-keys" class="tab-panel fade-in hidden">
      <KeysTab client:load />
    </div>

    <!-- ======================== WIZARD TAB (React Island) ======================== -->
    <div id="tab-wizard" class="tab-panel fade-in hidden">
      <WizardTab client:load />
    </div>

  </div>

  <!-- Key status pill (React Island) -->
  <KeyStatusPill client:load />

  <!-- Toast (React Island) -->
  <Toast client:load />

  <!-- Tab navigation via Nano Stores -->
  <script>
    import { $activeTab } from '../../stores/activeTab';
    $activeTab.subscribe((tab) => {
      ['encrypt', 'decrypt', 'keys', 'wizard'].forEach((t) => {
        document.getElementById('tab-' + t)?.classList.toggle('hidden', t !== tab);
      });
      document.querySelectorAll('.app-tab').forEach((btn) => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.tab === tab);
      });
    });
    document.querySelectorAll('.app-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = (btn as HTMLElement).dataset.tab;
        if (tab) $activeTab.set(tab as 'encrypt' | 'decrypt' | 'keys' | 'wizard');
      });
    });
  </script>
</Layout>

<style is:global>
  /* ── Tab bar ── */
  .app-tab-bar {
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 3.5rem;
    z-index: 40;
  }
  .app-tab-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    gap: 0;
  }
  .app-tab {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #6b7280;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .app-tab:hover { color: #374151; }
  .app-tab.active { color: #4f46e5; border-bottom-color: #4f46e5; }
  .app-tab svg { opacity: 0.7; }
  .app-tab.active svg { opacity: 1; }

  /* ── Tab panels ── */
  .tab-panel { min-height: 60vh; }
  .tab-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-top: 0.5rem;
  }
  .tab-title { font-size: 1.125rem; font-weight: 700; color: #111827; margin: 0 0 0.2rem; }
  .tab-subtitle { font-size: 0.8125rem; color: #6b7280; margin: 0; }

  /* ── Cards ── */
  .card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.625rem;
    padding: 1.25rem;
    margin-bottom: 0;
  }
  .card-title { font-size: 0.875rem; font-weight: 600; color: #111827; margin: 0 0 0.5rem; }
  .card-icon {
    width: 44px; height: 44px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .card-btn {
    display: flex; flex-direction: column; gap: 0.625rem;
    cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s;
    background: #fff; border: 2px solid #e5e7eb;
  }
  .card-btn:hover { border-color: #818cf8; box-shadow: 0 4px 12px rgb(99 102 241 / 0.1); }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
    background: #4f46e5; color: #fff;
    font-size: 0.875rem; font-weight: 600;
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem; border: none; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: #4338ca; }
  .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-secondary {
    display: inline-flex; align-items: center;
    background: #f3f4f6; color: #374151;
    font-size: 0.8125rem; font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem; border: 1px solid #e5e7eb; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-secondary:hover { background: #e5e7eb; }
  .btn-ghost { background: transparent; border: none; cursor: pointer; font-size: 0.8125rem; color: #9ca3af; transition: color 0.15s; padding: 0.25rem 0; }
  .btn-ghost:hover { color: #4f46e5; }
  .btn-ghost-sm { background: transparent; border: none; cursor: pointer; font-size: 0.75rem; color: #9ca3af; transition: color 0.15s; padding: 0.25rem 0.5rem; }
  .btn-ghost-sm:hover { color: #374151; }
  .btn-sm {
    display: inline-flex; align-items: center;
    background: #4f46e5; color: #fff;
    font-size: 0.75rem; font-weight: 500;
    padding: 0.375rem 0.875rem; border-radius: 0.375rem; border: none; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-sm:hover { background: #4338ca; }
  .link-inline { background: none; border: none; cursor: pointer; color: #4f46e5; font-size: inherit; padding: 0; text-decoration: underline; }
  .link-inline:hover { color: #3730a3; }

  /* ── Inputs ── */
  .input {
    border: 1px solid #d1d5db; border-radius: 0.5rem;
    padding: 0.5rem 0.75rem; font-size: 0.875rem;
    outline: none; transition: box-shadow 0.15s;
    font-family: inherit;
  }
  .input:focus { box-shadow: 0 0 0 2px #6366f1; border-color: #6366f1; }

  /* ── Drop zones ── */
  .drop-zone { border: 2px dashed #d1d5db; border-radius: 0.5rem; cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .drop-zone:hover, .drop-zone.dragover { border-color: #6366f1; background: #eef2ff; }
  .drop-zone-lg { padding: 2rem 1rem; text-align: center; }
  .drop-zone-sm { padding: 1rem; text-align: center; }
  .drop-icon { margin: 0 auto 0.5rem; color: #d1d5db; }

  /* ── Search ── */
  .search-wrap { position: relative; margin-bottom: 0.75rem; }
  .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #9ca3af; pointer-events: none; }
  .search-input { width: 100%; padding: 0.5rem 1rem 0.5rem 2.25rem; border: 1px solid #d1d5db; border-radius: 0.625rem; font-size: 0.875rem; outline: none; box-sizing: border-box; }
  .search-input:focus { box-shadow: 0 0 0 2px #6366f1; border-color: #6366f1; }

  /* ── Contact list ── */
  .contact-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }

  /* ── Empty state ── */
  .empty-state { text-align: center; padding: 3rem 1rem; }
  .empty-icon { width: 56px; height: 56px; background: #f3f4f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: #9ca3af; }
  .empty-msg { font-size: 0.875rem; font-weight: 500; color: #374151; margin: 0 0 0.25rem; }
  .empty-hint { font-size: 0.75rem; color: #9ca3af; margin: 0; }

  /* ── Encrypt panel ── */
  .encrypt-panel { background: #fff; border: 1px solid #c7d2fe; border-radius: 0.75rem; padding: 1.25rem; box-shadow: 0 1px 4px rgb(99 102 241 / 0.08); }
  .encrypt-panel-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem; }
  .encrypt-panel-label { font-size: 0.625rem; font-weight: 600; color: #6366f1; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.2rem; }
  .encrypt-panel-name { font-size: 1rem; font-weight: 600; color: #111827; margin: 0 0 0.15rem; }
  .encrypt-panel-fp { font-size: 0.7rem; color: #6b7280; font-family: ui-monospace, monospace; margin: 0; }

  /* ── Notice boxes ── */
  .notice-box { border-radius: 0.5rem; padding: 0.875rem 1rem; }
  .notice-info { background: #eef2ff; border: 1px solid #c7d2fe; }
  .notice-warn { background: #fffbeb; border: 1px solid #fde68a; }

  /* ── Success box ── */
  .success-box { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 0.625rem; padding: 1rem 1.25rem; }
  .success-title { font-size: 0.875rem; font-weight: 600; color: #14532d; margin: 0 0 0.25rem; }
  .success-body { font-size: 0.8125rem; color: #166534; margin: 0; }

  /* ── File info ── */
  .file-info { font-size: 0.875rem; color: #4b5563; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5rem 0.75rem; }

  /* ── Divider ── */
  .divider { display: flex; align-items: center; gap: 0.75rem; font-size: 0.75rem; color: #9ca3af; margin: 0.75rem 0; }
  .divider::before, .divider::after { content: ''; flex: 1; border-top: 1px solid #e5e7eb; }

  /* ── Key badge ── */
  .key-badge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; font-weight: 500; padding: 0.25rem 0.625rem; border-radius: 9999px; }
  .key-badge-ok { background: #dcfce7; color: #15803d; }
  .key-pill { font-size: 0.75rem; padding: 0.375rem 0.75rem; border-radius: 9999px; background: #f3f4f6; color: #6b7280; }
  .key-pill-ok { background: #dcfce7; color: #15803d; }

  /* ── Folder save bar ── */
  .folder-bar { display: flex; align-items: center; justify-content: space-between; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 0.5rem 0.875rem; }
  .folder-bar-inner { display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: #64748b; min-width: 0; overflow: hidden; }
  .folder-bar-inner strong { color: #334155; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
  .folder-bar-label { white-space: nowrap; }
  .btn-xs {
    display: inline-flex; align-items: center; gap: 0.25rem;
    background: #fff; color: #4f46e5; border: 1px solid #c7d2fe;
    font-size: 0.6875rem; font-weight: 600;
    padding: 0.25rem 0.625rem; border-radius: 0.375rem; cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap; flex-shrink: 0;
  }
  .btn-xs:hover { background: #eef2ff; border-color: #818cf8; }

  /* ── Sign row ── */
  .sign-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }

  /* ── Code block ── */
  .code-block { background: #fff; border: 1px solid #fde68a; border-radius: 0.375rem; padding: 0.75rem; font-size: 0.75rem; font-family: ui-monospace, monospace; color: #374151; white-space: pre-wrap; }

  /* ── Wizard progress ── */
  .wizard-progress { display: flex; align-items: center; justify-content: space-between; padding: 0.625rem 0; margin-bottom: 1rem; border-bottom: 1px solid #e5e7eb; }

  /* ── Grid ── */
  .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mt-3 { margin-top: 0.75rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-3 { margin-bottom: 0.75rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-5 { margin-bottom: 1.25rem; }
  .ml-5 { margin-left: 1.25rem; }
  .mt-0\.5 { margin-top: 0.125rem; }
  .w-full { width: 100%; }

  /* ── Local assurance bar ── */
  .local-assurance-bar {
    display: flex; align-items: center; gap: 0.5rem;
    background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.8125rem; color: #166534;
  }
  .local-assurance-bar svg { flex-shrink: 0; color: #16a34a; }

  /* ── Keys section labels ── */
  .keys-section-label {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .keys-private-label { color: #92400e; }
  .keys-private-label svg { color: #d97706; }
  .keys-public-label { color: #065f46; }
  .keys-public-label svg { color: #059669; }
  .keys-section-badge {
    font-size: 0.625rem; font-weight: 600; text-transform: none; letter-spacing: 0.02em;
    padding: 0.15rem 0.5rem; border-radius: 9999px;
  }
  .keys-private-badge { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
  .keys-public-badge { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }

  /* ── Private key card (vault aesthetic) ── */
  .private-key-card {
    background: #1c1917; border: 1px solid #44403c; border-radius: 0.75rem; padding: 1.25rem;
    color: #e7e5e4;
  }
  .private-key-card-empty {
    background: #292524; border-color: #3c3835;
    text-align: center; padding: 1.75rem 1.25rem;
  }
  .private-key-vault-row { display: flex; align-items: center; gap: 0.875rem; margin-bottom: 1rem; }
  .private-key-vault-icon {
    width: 44px; height: 44px; background: #292524; border: 1px solid #57534e;
    border-radius: 0.625rem; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: #f59e0b;
  }
  .private-key-vault-info { flex: 1; min-width: 0; }
  .private-key-vault-status { flex-shrink: 0; }
  .private-key-uid { font-size: 0.9375rem; font-weight: 600; color: #f5f5f4; margin: 0 0 0.2rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .private-key-fp { font-size: 0.6875rem; font-family: ui-monospace, monospace; color: #a8a29e; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vault-loaded-badge {
    display: inline-flex; align-items: center; gap: 0.25rem;
    background: #14532d; color: #bbf7d0; border: 1px solid #166534;
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem; border-radius: 9999px;
  }
  .private-key-warning-strip {
    display: flex; align-items: flex-start; gap: 0.5rem;
    background: #292524; border: 1px solid #78350f; border-radius: 0.5rem;
    padding: 0.625rem 0.75rem; margin-bottom: 1rem;
    font-size: 0.75rem; color: #fbbf24; line-height: 1.4;
  }
  .private-key-warning-strip strong { color: #fde68a; }
  .private-key-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .private-key-empty-icon {
    width: 52px; height: 52px; background: #292524; border: 1px solid #44403c;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 0.875rem; color: #57534e;
  }
  .private-key-empty-title { font-size: 0.9375rem; font-weight: 600; color: #d6d3d1; margin: 0 0 0.375rem; }
  .private-key-empty-body { font-size: 0.8125rem; color: #a8a29e; margin: 0; line-height: 1.5; }
  .private-key-section-title { font-size: 0.875rem; font-weight: 600; color: #f5f5f4; margin: 0 0 0.375rem; }
  .private-key-section-body { font-size: 0.8125rem; color: #a8a29e; margin: 0 0 0.75rem; line-height: 1.5; }
  .private-key-section-body strong { color: #fde68a; }
  .key-gen-local-note {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.75rem; color: #6ee7b7; background: #022c22; border: 1px solid #065f46;
    border-radius: 0.375rem; padding: 0.375rem 0.625rem;
  }
  .key-gen-local-note svg { color: #34d399; flex-shrink: 0; }

  /* ── Private key card buttons ── */
  .btn-vault-action {
    display: inline-flex; align-items: center; gap: 0.375rem;
    background: #292524; color: #fbbf24; border: 1px solid #57534e;
    font-size: 0.8125rem; font-weight: 600;
    padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-vault-action:hover { background: #3c3835; border-color: #78350f; }
  .btn-vault-action:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-vault-secondary {
    display: inline-flex; align-items: center; gap: 0.375rem;
    background: transparent; color: #a8a29e; border: 1px solid #44403c;
    font-size: 0.8125rem; font-weight: 500;
    padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .btn-vault-secondary:hover { color: #d6d3d1; border-color: #57534e; }
  .btn-vault-generate {
    display: inline-flex; align-items: center; gap: 0.375rem;
    background: #f59e0b; color: #1c1917; border: none;
    font-size: 0.875rem; font-weight: 700;
    padding: 0.625rem 1.25rem; border-radius: 0.5rem; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-vault-generate:hover { background: #d97706; }

  /* ── Public key card (open, light aesthetic) ── */
  .public-key-card {
    background: #f0fdf4; border: 1px solid #a7f3d0; border-radius: 0.75rem; padding: 1.25rem;
  }
  .public-key-intro { margin-bottom: 0.875rem; }
  .public-key-desc { font-size: 0.8125rem; color: #065f46; margin: 0 0 0.5rem; line-height: 1.5; }
  .public-key-source-note {
    display: flex; align-items: flex-start; gap: 0.375rem;
    font-size: 0.75rem; color: #047857; line-height: 1.4;
  }
  .public-key-source-note svg { flex-shrink: 0; margin-top: 0.1rem; }
  .public-key-source-note strong { color: #065f46; }
  .public-key-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .btn-public-action {
    display: inline-flex; align-items: center; gap: 0.375rem;
    background: #fff; color: #059669; border: 1px solid #6ee7b7;
    font-size: 0.8125rem; font-weight: 500;
    padding: 0.4375rem 0.875rem; border-radius: 0.5rem; cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-public-action:hover { background: #ecfdf5; border-color: #34d399; }
  .btn-public-publish {
    display: inline-flex; align-items: center; gap: 0.375rem;
    background: #059669; color: #fff; border: none;
    font-size: 0.8125rem; font-weight: 600;
    padding: 0.4375rem 0.875rem; border-radius: 0.5rem; cursor: pointer;
    transition: background 0.15s;
  }
  .btn-public-publish:hover { background: #047857; }
  .btn-public-publish:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Contact key rows (Keys tab recipients section) ── */
  .contact-key-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.5rem 0; border-bottom: 1px solid #a7f3d0;
  }
  .contact-key-row:last-child { border-bottom: none; }
  .contact-key-info { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; min-width: 0; }
  .contact-key-name { font-size: 0.8125rem; font-weight: 600; color: #065f46; }
  .contact-key-email { font-size: 0.75rem; color: #059669; }
  .contact-key-fp { font-size: 0.6875rem; font-family: ui-monospace, monospace; color: #6ee7b7; }
  .btn-contact-remove {
    background: none; border: none; cursor: pointer; color: #6ee7b7; padding: 0.25rem; border-radius: 0.25rem;
    transition: color 0.15s;
  }
