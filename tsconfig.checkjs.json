{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["vitest/globals", "node"],
    "moduleResolution": "bundler"
  },
  "include": [
    "public/js/app.js",
    "src/types/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
