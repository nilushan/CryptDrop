{
  "name": "cryptdrop-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "setup:local": "node scripts/operations.mjs setup:local",
    "dev": "npm run dev -w frontend --",
    "dev:backend": "npm run dev -w backend --",
    "dev:pages": "npm run build && npm run dev:pages -w frontend --",
    "build": "npm run build -w frontend --",
    "deploy:frontend": "npm run deploy -w frontend --",
    "deploy:backend": "npm run deploy -w backend --",
    "deploy:backend:dry-run": "npm run deploy:dry-run -w backend --",
    "check:pages": "npm run check:pages -w frontend",
    "check": "npm test && npm run typecheck && npm run deploy:backend:dry-run && npm run check:pages && npm run test:deployment",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deployment": "npm run build && node scripts/smoke-test.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "db:migration:create": "npm run db:migration:create -w backend --",
    "db:status:local": "npm run db:status:local -w backend",
    "db:migrate:local": "npm run db:migrate:local -w backend",
    "db:seed:local": "node scripts/operations.mjs db:seed:local",
    "db:status:remote": "npm run db:status:remote -w backend",
    "db:backup:remote": "node scripts/operations.mjs db:backup:remote",
    "db:migrate:remote": "npm run db:migrate:remote -w backend",
    "logs:backend": "npm run logs -w backend --"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.79.0"
  }
}
