---
import Layout from '../layouts/Layout.astro';
import '../styles/feedback.css';
import InviteAcceptPage from '../components/invite/InviteAcceptPage';
---

<Layout title="Accept Invitation — CryptDrop" description="Set up your encryption keys to receive encrypted files">
  <InviteAcceptPage client:load />
</Layout>

<style is:global>
  .invite-page-container {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem 1rem;
    min-height: 60vh;
    background: var(--cd-color-page);
  }
  .invite-card {
    width: 100%;
    max-width: 480px;
    background: var(--cd-color-surface);
    border: 1px solid #d5dce7;
    border-radius: 1rem;
    box-shadow: 0 2px 4px rgb(31 41 55 / .03), 0 12px 32px rgb(31 41 55 / .07);
    padding: 2rem;
  }
  .invite-card h1 { font-size: 1.5rem; margin: 0 0 1.5rem; text-align: center; }
  .invite-welcome h2 {
    font-size: 1.125rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }
  .invite-welcome p {
    font-size: 0.875rem;
    color: var(--cd-color-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  .invite-loading {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--cd-color-muted);
    font-size: 0.875rem;
  }
  .invite-error {
    text-align: center;
    padding: 2rem 1rem;
  }
  .invite-error svg {
    margin: 0 auto 1rem;
    display: block;
  }
  .invite-error h2 {
    font-size: 1rem;
    color: #1c1917;
    margin: 0 0 0.5rem;
  }
  .invite-error p {
    font-size: 0.875rem;
    color: var(--cd-color-muted);
  }
  .invite-error a {
    color: var(--cd-color-action);
    text-decoration: underline;
  }
  .invite-cta-btn {
    display: inline-block;
    background: #1c1917;
    color: var(--cd-color-surface);
    padding: 0.75rem 2rem;
    border-radius: 0.75rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    box-shadow: 0 2px 4px rgb(31 41 55 / .1);
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }
  .invite-cta-btn:focus-visible {
    box-shadow: 0 4px 12px rgb(31 41 55 / .16);
  }
  @media (hover: hover) and (pointer: fine) {
    .invite-cta-btn:not([aria-disabled="true"]):hover {
      background: #292524;
      box-shadow: 0 4px 12px rgb(31 41 55 / .16);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .invite-cta-btn { transition: transform 200ms ease, background-color 200ms ease, box-shadow 200ms ease; }
    .invite-cta-btn:not([aria-disabled="true"]):hover { transform: translateY(-1px); }
    .invite-cta-btn:not([aria-disabled="true"]):active { transform: translateY(0); }
  }

  .invite-lock { margin: 0 0 1rem; }
  .invite-welcome {
    text-align: center;
  }
  .invite-footnote {
    font-size: 0.8125rem;
    color: var(--cd-color-muted);
    margin: 1.25rem 0 0;
    line-height: 1.5;
  }
</style>

<style is:global>
  .invite-page-container { overflow-wrap: anywhere; }
  .invite-page-container :is(a, button):focus-visible { outline: 3px solid var(--cd-color-focus); outline-offset: 4px; }
  .invite-page-container .invite-cta-btn { min-height: 44px; }
  @media (max-width: 420px) { .invite-card { padding: 1.25rem; } }
  @media (prefers-reduced-motion: reduce) { .invite-page-container * { transition: none !important; animation: none !important; } }
</style>
