---
import Layout from '../layouts/Layout.astro';
import MarketingSection from '../components/marketing/MarketingSection.astro';
import MarketingCTA from '../components/marketing/MarketingCTA.astro';
import { keySecuritySafeguards, keySecurityLimitations } from '../lib/key-security';

const localItems = [
  {
    icon: '&#x1f510;',
    title: 'Key generation',
    detail: 'Your private and public keys are generated using Curve25519 via OpenPGP.js in your browser. Your private key is protected with your passphrase before storage. Generation also automatically attempts to register your public key and identity with the CryptDrop API; see the network details below.',
  },
  {
    icon: '&#x1f512;',
    title: 'File encryption & decryption',
    detail: 'Files are encrypted and decrypted inside your browser tab. CryptDrop does not upload file contents. Decrypted results are held in browser memory until cleared or saved by you; downloading a result writes a plaintext copy to your chosen location. Browser and operating-system memory handling is outside the app’s control.',
  },
  {
    icon: '&#x270d;&#xfe0f;',
    title: 'Digital signatures',
    detail: 'Your private key creates signatures locally, and signature verification also runs locally. Obtaining a sender’s public key by email lookup is a separate network request.',
  },
  {
    icon: '&#x1f5dd;&#xfe0f;',
    title: 'Private key storage',
    detail: 'If you choose "Remember on this device", CryptDrop saves a fully passphrase-protected private key in this site’s IndexedDB, not your passphrase or unlocked key. Encryption protects the saved copy, but a stolen copy can be subjected to offline passphrase guessing. Browser storage is not a backup.',
  },
  {
    icon: '&#x1f4c7;',
    title: 'Contact address book',
    detail: 'Saved contacts (names, emails, public keys) are stored in your browser’s localStorage. CryptDrop does not upload or sync the address book as a collection. Looking up a contact or sending an invitation can send selected names or email addresses to network services. localStorage is not encrypted by the app.',
  },
  {
    icon: '&#x1f4dc;',
    title: 'Activity history',
    detail: 'Encrypt/decrypt history is stored in localStorage, not encrypted by the app. It includes filenames, sizes, timestamps, a signed flag, and recipient or sender details, but not file contents. The history collection is not uploaded. An optional instructions email sends a filename separately. You can clear history or enable auto-clear on page exit; browser events are not guaranteed to run.',
  },
];

const cloudItems = [
  {
    icon: '&#x1f50d;',
    title: 'Public key lookup',
    what: 'The email address you search for',
    where: 'CryptDrop registry, then keys.openpgp.org',
    detail: 'Email lookup sends the searched address to the CryptDrop API (GET /api/lookup/:email). The backend checks its registry, then queries keys.openpgp.org if needed. If the API fails, the browser can query that keyserver directly. No file contents or private keys are included.',
  },
  {
    icon: '&#x1f4e4;',
    title: 'Public key publishing',
    what: 'Your public key, including its identity information',
    where: 'keys.openpgp.org',
    detail: 'If you choose to publish your public key, the armored public key text is uploaded to keys.openpgp.org so others can find you. Your private key is never included. The app may then request address verification from the keyserver; email delivery is not guaranteed.',
  },
  {
    icon: '&#x2709;&#xfe0f;',
    title: 'Email verification',
    what: 'A verification token and your email address',
    where: 'keys.openpgp.org',
    detail: 'After uploading a public key, CryptDrop can send the returned verification token and unpublished email addresses to the keyserver (POST /vks/v1/request-verify) to request confirmation emails. This is separate from the CryptDrop registry.',
  },
  {
    icon: '&#x1f4dd;',
    title: 'Key registration',
    what: 'Your name, email, public key, fingerprint, and invitation token if present',
    where: 'CryptDrop registry (POST /api/register)',
    detail: 'Generating a key pair automatically attempts registration with the CryptDrop API. This is nonblocking and best-effort, not an opt-in publishing step or a guarantee of registration. The backend stores successful registrations so others can find your key by email. Your private key and passphrase are not included.',
  },
  {
    icon: '&#x1f4e7;',
    title: 'Invitation emails',
    what: 'Sender name, sender email, recipient email',
    where: 'CryptDrop backend (POST /api/invite)',
    detail: 'Sending an invitation sends the sender’s name and email and the recipient’s email to the API. The backend stores an invitation record and attempts to send an invitation link via Resend. No file contents or keys are included; email delivery is not guaranteed.',
  },
  {
    icon: '&#x1f517;',
    title: 'Opening an invitation',
    what: 'The invitation token from the link',
    where: 'CryptDrop API (GET /api/invite/:token)',
    detail: 'Opening an invitation link sends its token to the API for validation. The response can include the sender’s name and email, recipient email, and invitation status. The token is also passed into guided setup for registration. Treat invitation links as sensitive.',
  },
  {
    icon: '&#x1f4ec;',
    title: 'Invitation acceptance notifications',
    what: 'Inviter email, registering person’s name and email',
    where: 'CryptDrop backend to Resend',
    detail: 'Registration can mark invitations accepted using the invitation token or matching email address. The backend then attempts to notify the inviter via Resend, including the registering person’s name and email. This is not a guarantee that an email arrives.',
  },
  {
    icon: '&#x1f514;',
    title: 'Decrypt instructions email',
    what: 'Recipient email, loaded sender user ID (which can include name and email), and the selected file’s original filename',
    where: 'CryptDrop backend (POST /api/notify)',
    detail: 'If you choose to send decrypt instructions after encryption, the API receives the recipient’s email, the loaded sender user ID (which can include name and email), the original filename, and the notification type. If no sender identity is loaded, “Someone” is sent instead. The backend passes these email details to Resend to attempt delivery; the sender user ID appears in the recipient’s email subject and body. A filename can reveal sensitive information even though file contents are not sent.',
  },
  {
    icon: '&#x1f4e8;',
    title: 'Sharing a public key by email',
    what: 'Your public key and public identity in a draft email',
    where: 'Your email application (mailto link)',
    detail: 'The public-key email action opens your email application with a draft containing your public key and identity. Sending it is handled by your email application and provider, not by CryptDrop’s API. No private key is included.',
  },
];

const neverSent = [
  'Your private key',
  'Your passphrase',
  'Unencrypted file contents',
  'Encrypted file contents',
  'Decrypted file contents',
  'Your activity history as a collection',
  'Your contact list as a collection',
];
---

<Layout title="Security & Privacy — CryptDrop" description="How CryptDrop protects your data. What stays local, what reaches the cloud, and the security measures built into every layer.">

  <style>
    .security-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
      padding: var(--cd-space-9) var(--cd-space-6) var(--cd-space-8);
      text-align: center;
    }
    .security-hero h1 {
      font-size: 2.25rem;
      line-height: 1.2;
      font-weight: 800;
      color: var(--cd-color-on-action);
      letter-spacing: -.03em;
      margin: 0 auto var(--cd-space-4);
      max-width: 36rem;
    }
    .security-hero p {
      font-size: 1.125rem;
      color: #c7d2fe;
      max-width: 36rem;
      margin: 0 auto;
      line-height: 1.7;
    }
    .security-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: var(--cd-space-4);
      overflow-wrap: anywhere;
    }
    :global(#local-processing) { background: var(--cd-color-success-bg); }
    .security-network { background: var(--cd-color-warning-bg); }
    .security-never { background: var(--cd-color-error-bg); }
    :global(#security-measures) { background: var(--cd-color-info-bg); }
    .local-card { border-color: #bbf7d0; }
    .local-card h3 { color: var(--cd-color-success-ink); }
    .local-card-icon { font-size: 1.5rem; margin-bottom: var(--cd-space-2); }
    .cloud-card { border-color: #fde68a; }
    .cloud-card + .cloud-card { margin-top: var(--cd-space-4); }
    .cloud-card-header { display: flex; align-items: flex-start; gap: var(--cd-space-3); margin-bottom: var(--cd-space-3); }
    .cloud-card-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
      width: 2.75rem;
      height: 2.75rem;
      display: grid;
      place-items: center;
      background: var(--cd-color-warning-bg);
      border-radius: var(--cd-radius-control);
    }
    .cloud-card h3, .cloud-card .cloud-meta { color: var(--cd-color-warning-ink); }
    .cloud-card-header > div:last-child { min-width: 0; overflow-wrap: anywhere; }
    .never-list { list-style: none; padding: 0; margin: 0; gap: var(--cd-space-2); }
    .never-item {
      display: flex;
      align-items: center;
      gap: var(--cd-space-2);
      background: var(--cd-color-surface);
      border: 1px solid #fecaca;
      border-radius: var(--cd-radius-control);
      padding: var(--cd-space-3) var(--cd-space-4);
      font-size: .875rem;
      line-height: 1.7;
      font-weight: 500;
      color: var(--cd-color-error-ink);
    }
    .never-item svg { flex-shrink: 0; }
    .hardening-card { border-color: #c7d2fe; }
    .hardening-card h3 { color: var(--cd-color-info-ink); }
    .security-safeguards { border-top: 4px solid var(--cd-color-success-ink); }
    .security-safeguards h3 { color: var(--cd-color-success-ink); }
    .security-limitations { border: 2px dashed var(--cd-color-warning-ink); background: var(--cd-color-warning-bg); }
    .security-limitations h3 { color: var(--cd-color-warning-ink); }
    .security-disclosure-title { display: flex; align-items: center; gap: var(--cd-space-2); }
    .security-disclosure-title svg { flex-shrink: 0; }
    .key-security-list {
      list-style: disc;
      margin: var(--cd-space-3) 0 0;
      padding-left: var(--cd-space-5);
      color: var(--cd-color-muted);
      font-size: 1rem;
      line-height: 1.7;
    }
    .key-security-list li + li { margin-top: var(--cd-space-3); }
    .key-security-guidance {
      max-width: 40rem;
      margin: var(--cd-space-7) auto 0;
      color: var(--cd-color-muted);
      font-size: 1rem;
      line-height: 1.7;
    }
    .key-security-guidance p + p { margin-top: var(--cd-space-5); }
    .privacy-jump-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--cd-space-2) var(--cd-space-5);
      max-width: 40rem;
      margin: var(--cd-space-6) auto 0;
      color: var(--cd-color-on-action);
      font-size: 1rem;
    }
    .privacy-jump-links a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: underline; text-underline-offset: .2em; }
    .privacy-jump-links a:focus-visible { outline-color: var(--cd-color-on-action); }
    .privacy-storage { margin-top: var(--cd-space-6); }
    .privacy-storage h3 { color: var(--cd-color-warning-ink); }
    .privacy-storage ul { padding-left: var(--cd-space-5); color: var(--cd-color-muted); font-size: 1rem; line-height: 1.7; }
    .privacy-storage li + li { margin-top: var(--cd-space-3); }
    .privacy-qualification { max-width: 40rem; margin: var(--cd-space-6) auto 0; color: var(--cd-color-muted); font-size: 1rem; line-height: 1.7; }
    @media (min-width: 768px) { .security-hero h1 { font-size: 2.75rem; } }
  </style>

  <!-- ======================== HERO ======================== -->
  <header class="security-hero">
    <h1>Security & Privacy</h1>
    <p>File contents, private keys, and passphrases are processed locally. Public identity, key discovery, and email workflows use network services. Read the data flows separately from the security safeguards.</p>
    <nav class="privacy-jump-links" aria-label="Security and privacy topics">
      <a href="#local-processing">On your device</a>
      <a href="#network-requests">Network services &amp; data</a>
      <a href="#never-transmitted">Not uploaded</a>
      <a href="#private-key-security">Private-key protections &amp; limits</a>
    </nav>
  </header>

  <!-- ======================== SECTION 1: LOCAL ONLY ======================== -->
  <MarketingSection id="local-processing" heading="What stays on your device" lead="File processing and private-key operations run locally. Local storage is different from sending data over the network, and not all stored data is encrypted. Some actions also send public identity or selected metadata, as described below.">
      <div class="security-grid">
        {localItems.map((item) => (
          <div class="marketing-card local-card">
            <div class="local-card-icon" aria-hidden="true" set:html={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>
  </MarketingSection>

  <section class="marketing-section marketing-section-plain" id="private-key-security" aria-labelledby="private-key-security-title">
    <div class="marketing-container">
      <header class="marketing-section-header">
        <h2 id="private-key-security-title">Private keys: protections and limits</h2>
        <p class="marketing-lead">Local processing reduces what you share with servers. It does not make a browser a hardware vault. These safeguards describe the current implementation, not a security certification or a guarantee against compromise.</p>
      </header>
      <div class="security-grid">
        <div class="marketing-card security-safeguards">
          <h3 class="security-disclosure-title"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Safeguards in place</h3>
          <ul class="key-security-list">{keySecuritySafeguards.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="marketing-card security-limitations">
          <h3 class="security-disclosure-title"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="m12 3 10 18H2L12 3zM12 9v5m0 3v1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Browser limitations</h3>
          <ul class="key-security-list">{keySecurityLimitations.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <div class="key-security-guidance">
        <p><strong>Saved is different from loaded.</strong> A remembered key is encrypted at rest. Loading it makes decrypted key material available to the app in memory for signing and decryption. Removing it from app state or closing the page is not a guarantee that every memory copy has been securely erased. The decrypted-file expiry timer does not unload your private key.</p>
        <p><strong>Older saved keys.</strong> Earlier versions may have saved unprotected keys. Those copies are not automatically deleted or made safe by an update. If warned about an older saved key, preserve a protected recovery copy first, then remove the unsafe browser copy. Do not delete your only copy.</p>
        <p><strong>For higher-risk use.</strong> Use a trusted, updated device and browser with minimal extensions. For especially sensitive keys, consider a trusted offline PGP tool or a hardware-backed workflow that does not expose an exportable private key to a web application. CryptDrop does not currently provide hardware-token integration.</p>
        <p><strong>Trust in delivered code.</strong> You also trust the code served by this site and its dependencies. Security headers reduce some risks but cannot make compromised application code safe. Using an audited cryptographic library does not mean the entire application has been independently audited.</p>
      </div>
    </div>
  </section>

  <!-- ======================== SECTION 2: WHAT REACHES THE CLOUD ======================== -->
  <section id="network-requests" class="marketing-section security-network" aria-labelledby="network-requests-heading">
    <div class="marketing-container">
      <header class="marketing-section-header">
        <h2 id="network-requests-heading">What reaches the cloud</h2>
        <p class="marketing-lead">The browser uses the CryptDrop API and the <a href="https://keys.openpgp.org">keys.openpgp.org</a> public keyserver for the workflows below. The backend uses Resend for email. These are application payloads, not an exhaustive inventory of HTTP metadata: loading the site and making requests also involves network information such as IP addresses. CryptDrop does not upload file contents, private keys, or passphrases in these workflows.</p>
      </header>

      {cloudItems.map((item) => (
        <div class="marketing-card cloud-card">
          <div class="cloud-card-header">
            <div class="cloud-card-icon" aria-hidden="true" set:html={item.icon} />
            <div>
              <h3>{item.title}</h3>
              <p class="cloud-meta">Sent to <strong>{item.where}</strong> &mdash; {item.what}</p>
            </div>
          </div>
          <p>{item.detail}</p>
        </div>
      ))}
      <div class="marketing-card privacy-storage">
        <h3>Data stored by the backend</h3>
        <ul>
          <li><strong>Registry:</strong> Cloudflare D1 stores registered names, emails, public keys, fingerprints, and creation/update timestamps.</li>
          <li><strong>Invitations:</strong> D1 stores the token, sender name and email, recipient email, status, and creation/acceptance timestamps.</li>
          <li><strong>Rate limiting:</strong> D1 stores an action and an identifier derived from the request’s IP headers (or “unknown”), with a request count and window start. This identifier is not hashed by the middleware.</li>
        </ul>
        <p>This is an implementation summary, not a retention or deletion policy. An expired invitation link does not mean its database record has been deleted.</p>
      </div>
    </div>
  </section>

  <!-- ======================== SECTION 3: NEVER SENT ======================== -->
  <section id="never-transmitted" class="marketing-section security-never" aria-labelledby="never-transmitted-heading">
    <div class="marketing-container">
      <header class="marketing-section-header">
        <h2 id="never-transmitted-heading">What is never transmitted</h2>
        <p class="marketing-lead">CryptDrop’s implemented workflows do not upload the following data. This describes normal application behavior, not a guarantee against malicious extensions, compromised code, or an infected device. See the <a href="#private-key-security">private-key protections and limits</a> above.</p>
      </header>

      <ul class="never-list security-grid">
        {neverSent.map((item) => (
          <li class="never-item">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><path d="M15 9l-6 6M9 9l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            {item}
          </li>
        ))}
      </ul>
      <p class="privacy-qualification">Names, email addresses, public keys, and filenames are different from file contents. Selected details can be sent by the <a href="#network-requests">network workflows above</a>, even though contact and history collections are not uploaded.</p>
    </div>
  </section>

  <!-- ======================== SECTION 4: SECURITY HARDENING ======================== -->
  <MarketingSection id="security-measures" heading="How CryptDrop hardens your security" lead="Beyond the encryption itself, multiple layers of protection are built into the app to minimize attack surface and protect your data." tone="gradient">
      <div class="security-grid">
        <div class="marketing-card hardening-card">
          <h3>Content Security Policy</h3>
          <p>The configured CSP restricts scripts to this origin and explicitly hashed inline scripts, and restricts fetch connections to this origin and keys.openpgp.org. It reduces some injection and data-exfiltration risks; it does not protect secrets from all compromised same-origin code or privileged extensions.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>Modern cryptography</h3>
          <p>New keys use Curve25519 via OpenPGP.js 6.x, which implements OpenPGP encryption and signatures. Cryptographic algorithms are only one part of security; passphrases, key handling, application code, and device integrity also matter.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>Passphrase protection</h3>
          <p>New key generation requires a passphrase of at least 12 characters and a minimum strength score. Imported keys retain their existing protection. Remember on this device rejects unprotected or partially protected keys. Passphrases are not persisted by the app; clearing a form does not guarantee secure memory erasure.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>Decrypted file auto-clear</h3>
          <p>A five-minute timer removes the decrypted result from app state. Browser scheduling can delay timers, and dropping a reference does not guarantee secure memory erasure. Downloaded copies remain on disk, and this timer does not unload your private key.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>Filename sanitization</h3>
          <p>Filenames embedded in encrypted files are sanitized on decryption to prevent path traversal attacks. Control characters, directory separators, and excessive lengths are stripped.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>Public-key lookup warnings</h3>
          <p>Public-key lookup compares the first user ID with the searched email and can show an email-mismatch warning. A missing user ID may not trigger a warning. This check does not reject a mismatched key, prove its owner’s identity, or rule out a malicious key. Verify the fingerprint through a trusted channel.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>Security headers</h3>
          <p>The deployment configuration includes HSTS, framing restrictions, Cross-Origin-Opener-Policy, and Referrer-Policy: no-referrer. When served correctly, these reduce transport, framing, opener, and referrer risks. They do not isolate one CryptDrop tab’s IndexedDB storage from another.</p>
        </div>
        <div class="marketing-card hardening-card">
          <h3>No tracking or analytics</h3>
          <p>The app does not include analytics scripts or tracking pixels. Network workflows include the CryptDrop API and keys.openpgp.org, as described above; generating keys also attempts to register your public key and identity with the API.</p>
        </div>
      </div>
  </MarketingSection>

  <!-- ======================== SECTION 5: OPEN SOURCE ======================== -->
  <MarketingSection id="review-source" heading="Don't take our word for it" lead="CryptDrop is built on OpenPGP.js, a widely audited open-source encryption library. The source code is publicly available for review — you can read every line, inspect the network requests in your browser's DevTools, and verify every claim on this page yourself.">
    <div class="marketing-cta-group">
      <MarketingCTA href="/app">Open CryptDrop &rarr;</MarketingCTA>
      <MarketingCTA href="https://github.com/nilushan/CryptDrop" variant="secondary">View CryptDrop source on GitHub</MarketingCTA>
      <MarketingCTA href="/how-it-works" variant="secondary">See How It Works</MarketingCTA>
    </div>
  </MarketingSection>

</Layout>
